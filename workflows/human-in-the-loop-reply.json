    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  temperature: 0.4,\n  messages: [\n    { role: 'system', content: 'You write short, friendly, specific first replies to inbound leads. Under 120 words. No promises about price or dates. Ask one clear next-step question. Plain text only. End with this signature exactly:\\n' + $('Config').item.json.signature },\n    { role: 'user', content: 'Lead name: ' + $json.name + '\\nCompany: ' + ($json.company || 'n/a') + '\\nMessage:\\n' + $json.message + '\\n\\nTemplate draft to improve:\\n' + $json.draft }\n  ]\n}) }}",
        "options": {}
      },
