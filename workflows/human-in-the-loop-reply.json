        "jsonBody": "={{ JSON.stringify({\n  text: 'New lead from ' + $json.name + ' <' + $json.email + '> needs a reply',\n  blocks: [\n    { type: 'header', text: { type: 'plain_text', text: 'New lead: ' + ($json.name || $json.email) } },\n    { type: 'section', fields: [\n      { type: 'mrkdwn', text: '*Email:*\\n' + $json.email },\n      { type: 'mrkdwn', text: '*Company:*\\n' + ($json.company || '-') },\n      { type: 'mrkdwn', text: '*Intent:*\\n' + $json.intent },\n      { type: 'mrkdwn', text: '*Draft source:*\\n' + $json.draftSource }\n    ] },\n    { type: 'section', text: { type: 'mrkdwn', text: '*Their message:*\\n>' + $json.message.split('\\n').join('\\n>') } },\n    { type: 'section', text: { type: 'mrkdwn', text: '*Draft reply:*\\n```' + $json.draft + '```' } },\n    { type: 'actions', elements: [\n      { type: 'button', style: 'primary', text: { type: 'plain_text', text: 'Review: approve, edit or reject' }, url: $execution.resumeFormUrl }\n    ] },\n    { type: 'context', elements: [ { type: 'mrkdwn', text: 'Nothing is sent until someone approves. Link expires in 48h.' } ] }\n  ]\n}) }}",
        "options": {}
